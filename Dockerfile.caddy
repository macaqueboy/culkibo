# Imagen oficial de Caddy compilada con el proveedor DNS-01 de Cloudflare
# para emitir múltiples certificados Wildcard (*.dominio.com) automáticamente.
# Uso: docker build -f Dockerfile.caddy -t culkibo-caddy:cloudflare .
FROM caddy:2.11-builder-alpine AS builder

RUN xcaddy build \
  --with github.com/caddy-dns/cloudflare

FROM caddy:2.11-alpine

COPY --from=builder /usr/bin/caddy /usr/bin/caddy
