# ---------------------------------------------------------------------------
# Dependencias y artefactos de compilación
# ---------------------------------------------------------------------------
node_modules/
web/node_modules/
web/dist/
*.log
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Secretos — NUNCA versionar
#
# Si algo de aquí acaba en un commit, no basta con borrarlo después: queda en
# el historial para siempre. Ante la duda, no lo añadas.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# Claves privadas TLS emitidas por el gestor de certificados
data/certs/
*.pem
*.key
*.pfx
*.p12

# Credenciales de servicios.
# OJO: en .gitignore los comentarios NO pueden ir al final de una línea de
# patrón — git se traga el comentario como parte del patrón y la regla deja de
# funcionar en silencio. Cada comentario, en su propia línea.
#
# Personal Access Token de GitHub
data/github.json
# Token de API de Cloudflare
data/cloudflare-config.json
# Tokens de bot de Telegram y webhooks de Discord / Slack
data/notifications.json
# Bases de datos gestionadas: contraseñas cifradas, endpoint y clave de acceso
# de S3/R2. El cifrado protege de una fuga accidental, no es permiso para
# versionarlo.
data/databases.json
data/databases.json.*.tmp
# Clave AES con la que se cifra lo anterior. `*.key` ya la cubre, pero esta es
# la que de verdad no puede salir de la máquina.
data/.databases.key

# ---------------------------------------------------------------------------
# Estado en tiempo de ejecución del daemon
# Es de cada instalación: no pertenece al repositorio.
# ---------------------------------------------------------------------------
data/projects.json
data/projects.json.bak
data/projects.json.*.tmp
data/domains.json
data/ingress.json
data/ingress.json.*.tmp
data/deployments.json
data/deployments.json.*.tmp
data/services.json
data/services.json.*.tmp
data/.services.key
data/services/
data/backups/
data/audit.jsonl
data/audit.jsonl.*
data/crons.json
data/crons.json.bak
data/crons.json.*.tmp
data/previews.json
data/previews.json.bak
data/previews.json.*.tmp
data/domains.json.bak
data/ingress.json.bak
data/deployments.json.bak
data/services.json.bak
data/databases.json.bak
data/notifications.json.bak
# Ficheros efímeros de --env-file y de configuración de mongodump. Se borran
# solos, pero un proceso muerto a mitad puede dejar alguno.
data/.tmp/

# Código de terceros clonado por el runner local
projects/

# ---------------------------------------------------------------------------
# Ruido de desarrollo
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
screenshot*.png
capture_*.js
capture_*.mjs
take_screenshot*.js
take_screenshot*.mjs
data/auth.json

# Worktrees temporales de los agentes: son copias de trabajo, no fuente
.claude/
