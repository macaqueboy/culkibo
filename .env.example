# Culkibo — configuración de entorno
#
# Copia este fichero a `.env` y rellena lo que necesites.
# `.env` está en .gitignore: nunca se versiona.

# Puerto del daemon (API REST, WebSocket y dashboard)
PORT=3030

# ---------------------------------------------------------------------------
# Autenticación del plano de control
# ---------------------------------------------------------------------------
# Token para la API y el servidor MCP. Sin él, cualquier proceso de la máquina
# —y cualquier web que visites, si el daemon está expuesto— puede controlar
# Culkibo. Genera uno con:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# CULKIBO_TOKEN=

# Orígenes permitidos para el dashboard, separados por comas.
# Por defecto solo localhost. Añade aquí tu dominio si sirves el panel fuera.
# CULKIBO_ALLOWED_ORIGINS=http://localhost:3030,http://localhost:5173

# CIDRs de proxies inversos internos adicionales de confianza (separados por comas).
# Por defecto solo se confía en los rangos oficiales de Cloudflare + loopback.
# CULKIBO_TRUSTED_PROXIES=

# ---------------------------------------------------------------------------
# Telemetría anónima y diagnóstico de fallos (consulta PRIVACY.md)
# ---------------------------------------------------------------------------
# Pon 0 o false (o DO_NOT_TRACK=1) para desactivar la telemetría por completo.
# CULKIBO_TELEMETRY=1
# Endpoint personalizado de tu propio recolector (por defecto https://telemetry.culkibo.dev/v1/ingest)
# CULKIBO_TELEMETRY_URL=
# Imprimir cada lote JSON saneado en la consola del servidor (1 = activo)
# CULKIBO_TELEMETRY_DEBUG=0

# ---------------------------------------------------------------------------
# Integraciones (todas opcionales)
# ---------------------------------------------------------------------------
# Cloudflare: necesario para DNS-01 y certificados wildcard.
# Permisos mínimos del token: Zone:Read + DNS:Edit
# CLOUDFLARE_API_TOKEN=

# GitHub: se puede configurar desde la interfaz; esto es la alternativa headless.
# GITHUB_TOKEN=
