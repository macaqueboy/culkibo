# Puerto y dirección de escucha del recolector
PORT=8787
BIND=0.0.0.0
DATA_DIR=./data

# Activar (1) si el recolector está detrás de Caddy / Cloudflare / Nginx
TRUST_PROXY=1

# Token obligatorio para el panel Ops (/) y /admin/api/*
# Si se deja vacío, se genera automáticamente en data/admin-token.txt (modo 0600)
ADMIN_TOKEN=

# Días de retención de eventos individuales (los grupos de fallos agregados se conservan)
RETENTION_DAYS=90

# Alertas instantáneas (rellena uno o varios canales)
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_DISCORD_WEBHOOK=
ALERT_SLACK_WEBHOOK=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=

# Cooldown entre alertas repetidas del mismo fingerprint (en ms, 15 min por defecto)
ALERT_COOLDOWN_MS=900000
# Umbral de ocurrencias en 1 hora para disparar alerta de pico
ALERT_SPIKE_THRESHOLD=25
